# =============================================================================
# Syngenta Krishi Campaign Copilot — Backend Environment (Example)
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# Data mode: "local" | "mock" | "supabase" | "hybrid"
DATA_MODE=local

# Demo cache fallback: "true" | "false"
DEMO_CACHE_ENABLED=false

# Supabase connection
# Get from https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_STORAGE_BUCKET=exports

# LLM Provider: "gemini" (primary) | "openai" (fallback)
LLM_PROVIDER=gemini

# Gemini API key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API key (optional fallback provider)
# OPENAI_API_KEY=sk-placeholder
# LLM_MODEL=gpt-4.1-mini

# CORS allowed origins (comma-separated)
# Local: http://localhost:3000
# Deployed: https://syngenta-copilot.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DuckDB data path for CSV analytics
DUCKDB_DATA_PATH=./data/csv
