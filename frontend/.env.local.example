# =============================================================================
# Syngenta Krishi Campaign Copilot — Frontend Environment (Example)
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
#
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to version control.
# =============================================================================

# Backend API base URL (no trailing slash)
# Local development: http://localhost:8000
# Deployed (Render):  https://syngenta-copilot-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo mode: "true" = serve all data from /public/demo-cache/*.json
# Set to "false" when the FastAPI backend is running and reachable
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project URL — get from https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key — safe to expose; RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
